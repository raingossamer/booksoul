# 复制成 .env 再改。**.env 不进镜像也不该提交**（见 .dockerignore 与 .gitignore）。

# 数据库密码。这个库只绑 127.0.0.1，而且 tests/conftest.py 把
# `booksoul:booksoul@127.0.0.1:5432/booksoul_test` 写成了默认值 —— 改这里就要
# 同时设 BOOKSOUL_TEST_DATABASE_URL，否则测试连不上、并且是**静默跳过**不是报错。
POSTGRES_PASSWORD=booksoul

# 服务端自己的 JWT 签名密钥 —— **和模型 API key 无关**。
# 用户的模型 key 只存在他自己的浏览器，服务端用完即丢（backend.md「认证授权」）。
# HS256 要求不短于 32 字节。生成一条：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BOOKSOUL_SECRET_KEY=

# 浏览器访问的端口。只绑 127.0.0.1。
# 不用 8080：那是本机最常被别的容器占掉的一个。
BOOKSOUL_PORT=8317

# ---------------------------------------------------------------- 本地开发
# 下面两条只对**本机直接跑** uvicorn 的那条路生效（容器里由 compose 显式注入）。
# 本地开发连的是 compose 那个数据库，所以两边必须对「文件在哪」说同一句话：
# 库里存的是 `{user_id}/{book_id}-书名`，根目录一旦分叉，本地就会去一个空目录里
# 找一本库里明明有记录的书 —— 查不到，而且不报错。
BOOKSOUL_LIBRARY_ROOT=data/library
BOOKSOUL_UPLOAD_ROOT=data/uploads
